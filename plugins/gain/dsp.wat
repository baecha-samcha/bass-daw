;; Sample Gain — identity × gain(sample-rate param). ABI bass-daw-wasm-1
(module
  (memory (export "memory") 1 1)
  (global $heap (mut i32) (i32.const 49152))
  (func (export "abi_version") (result i32) (i32.const 0x00010000))
  (func (export "create") (param $sr f32) (param $max i32) (result i32)
    (if (i32.gt_u (local.get $max) (i32.const 512)) (then (return (i32.const 0))))
    (i32.const 1))
  (func (export "alloc") (param $n i32) (result i32) (local $p i32)
    (local.set $p (global.get $heap))
    (if (i32.gt_u (i32.add (local.get $p) (local.get $n)) (i32.const 65536)) (then (return (i32.const 0))))
    (global.set $heap (i32.add (local.get $p) (i32.and (i32.add (local.get $n) (i32.const 7)) (i32.const -8))))
    (local.get $p))
  (func (export "free") (param i32))
  (func (export "configure") (param i32 i32 i32) (result i32) (i32.const 0))
  (func (export "bind_sample") (param i32 i32 i32 i32 i32 f32) (result i32) (i32.const -1))
  (func (export "input_ptr") (param $h i32) (param $c i32) (result i32) (i32.add (i32.const 1024) (i32.mul (local.get $c) (i32.const 2048))))
  (func (export "output_ptr") (param $h i32) (param $c i32) (result i32) (i32.add (i32.const 5120) (i32.mul (local.get $c) (i32.const 2048))))
  (func (export "events_ptr") (param i32) (result i32) (i32.const 9216))
  (func (export "params_ptr") (param i32) (result i32) (i32.const 41984))
  (func (export "process") (param $h i32) (param $n i32) (param $ev i32) (result i32)
    (local $i i32) (local $off i32)
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $off (i32.shl (local.get $i) (i32.const 2)))
      (f32.store (i32.add (i32.const 5120) (local.get $off))
        (f32.mul (f32.load (i32.add (i32.const 1024) (local.get $off))) (f32.load (i32.add (i32.const 41984) (local.get $off)))))
      (f32.store (i32.add (i32.const 7168) (local.get $off))
        (f32.mul (f32.load (i32.add (i32.const 3072) (local.get $off))) (f32.load (i32.add (i32.const 41984) (local.get $off)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (i32.const 0))
  (func (export "reset") (param i32) (result i32) (i32.const 0))
  (func (export "destroy") (param i32))
)
