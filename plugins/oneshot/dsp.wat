;; One-shot sampler: slot 0 의 sample 을 noteOn 마다 처음부터 재생(최대 8 voice, round-robin steal).
;; rate = 2^((pitch - rootPitch)/12) × sampleRate/hostRate. noteOff 무시(one-shot), allNotesOff(6) 은 전부 정지.
(module
  (import "host" "pow" (func $pow (param f64 f64) (result f64)))
  (memory (export "memory") 128 128)
  (global $heap (mut i32) (i32.const 65536))
  (global $sr (mut f32) (f32.const 48000))
  (global $sPtr (mut i32) (i32.const 0))
  (global $sFrames (mut i32) (i32.const 0))
  (global $sRate (mut f32) (f32.const 48000))
  (global $next (mut i32) (i32.const 0))
  ;; voices @47104: 8 × [active i32, pos f32, rate f32, gain f32]
  (func (export "abi_version") (result i32) (i32.const 0x00010000))
  (func (export "create") (param $sr f32) (param $max i32) (result i32)
    (if (i32.gt_u (local.get $max) (i32.const 512)) (then (return (i32.const 0))))
    (global.set $sr (local.get $sr)) (i32.const 1))
  (func (export "alloc") (param $n i32) (result i32) (local $p i32)
    (local.set $p (global.get $heap))
    (if (i32.gt_u (i32.add (local.get $p) (local.get $n)) (i32.const 8388608)) (then (return (i32.const 0))))
    (global.set $heap (i32.add (local.get $p) (i32.and (i32.add (local.get $n) (i32.const 7)) (i32.const -8))))
    (local.get $p))
  (func (export "free") (param i32))
  (func (export "configure") (param i32 i32 i32) (result i32) (i32.const 0))
  (func (export "bind_sample") (param $h i32) (param $slot i32) (param $ptr i32) (param $ch i32) (param $frames i32) (param $rate f32) (result i32)
    (if (i32.ne (local.get $slot) (i32.const 0)) (then (return (i32.const -1))))
    (global.set $sPtr (local.get $ptr)) (global.set $sFrames (local.get $frames)) (global.set $sRate (local.get $rate))
    (i32.const 0))
  (func (export "input_ptr") (param i32 i32) (result i32) (i32.const 1024))
  (func (export "output_ptr") (param $h i32) (param $c i32) (result i32) (i32.add (i32.const 5120) (i32.mul (local.get $c) (i32.const 2048))))
  (func (export "events_ptr") (param i32) (result i32) (i32.const 9216))
  (func (export "params_ptr") (param i32) (result i32) (i32.const 41984))
  (func $event (param $e i32) (local $type i32) (local $v i32) (local $k i32)
    (local.set $type (i32.load offset=4 (local.get $e)))
    (if (i32.eq (local.get $type) (i32.const 6))
      (then (local.set $k (i32.const 0))
        (block $d (loop $l (br_if $d (i32.ge_u (local.get $k) (i32.const 8)))
          (i32.store (i32.add (i32.const 47104) (i32.shl (local.get $k) (i32.const 4))) (i32.const 0))
          (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $l)))
        (return)))
    (if (i32.ne (local.get $type) (i32.const 1)) (then (return)))
    (local.set $v (i32.add (i32.const 47104) (i32.shl (global.get $next) (i32.const 4))))
    (global.set $next (i32.and (i32.add (global.get $next) (i32.const 1)) (i32.const 7)))
    (i32.store (local.get $v) (i32.const 1))
    (f32.store offset=4 (local.get $v) (f32.const 0))
    (f32.store offset=8 (local.get $v)
      (f32.mul
        (f32.demote_f64 (call $pow (f64.const 2) (f64.div (f64.promote_f32 (f32.sub (f32.load offset=16 (local.get $e)) (f32.load (i32.const 44032)))) (f64.const 12))))
        (f32.div (global.get $sRate) (global.get $sr))))
    (f32.store offset=12 (local.get $v) (f32.load offset=20 (local.get $e))))
  (func (export "process") (param $h i32) (param $n i32) (param $ev i32) (result i32)
    (local $i i32) (local $e i32) (local $k i32) (local $v i32) (local $acc f32) (local $pos f32) (local $ip i32) (local $fr f32) (local $a f32) (local $s f32)
    (block $done (loop $frame
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      ;; 이 offset 의 이벤트 적용
      (block $evd (loop $evl
        (br_if $evd (i32.ge_u (local.get $e) (local.get $ev)))
        (br_if $evd (i32.ne (i32.load (i32.add (i32.const 9216) (i32.shl (local.get $e) (i32.const 5)))) (local.get $i)))
        (call $event (i32.add (i32.const 9216) (i32.shl (local.get $e) (i32.const 5))))
        (local.set $e (i32.add (local.get $e) (i32.const 1))) (br $evl)))
      (local.set $acc (f32.const 0)) (local.set $k (i32.const 0))
      (block $vd (loop $vl
        (br_if $vd (i32.ge_u (local.get $k) (i32.const 8)))
        (local.set $v (i32.add (i32.const 47104) (i32.shl (local.get $k) (i32.const 4))))
        (if (i32.load (local.get $v)) (then
          (local.set $pos (f32.load offset=4 (local.get $v)))
          (local.set $ip (i32.trunc_f32_u (local.get $pos)))
          (if (i32.ge_u (i32.add (local.get $ip) (i32.const 1)) (global.get $sFrames))
            (then (i32.store (local.get $v) (i32.const 0)))
            (else
              (local.set $fr (f32.sub (local.get $pos) (f32.convert_i32_u (local.get $ip))))
              (local.set $a (f32.load (i32.add (global.get $sPtr) (i32.shl (local.get $ip) (i32.const 2)))))
              (local.set $s (f32.add (local.get $a) (f32.mul (local.get $fr) (f32.sub (f32.load offset=4 (i32.add (global.get $sPtr) (i32.shl (local.get $ip) (i32.const 2)))) (local.get $a)))))
              (local.set $acc (f32.add (local.get $acc) (f32.mul (local.get $s) (f32.load offset=12 (local.get $v)))))
              (f32.store offset=4 (local.get $v) (f32.add (local.get $pos) (f32.load offset=8 (local.get $v))))))))
        (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $vl)))
      (local.set $acc (f32.mul (local.get $acc) (f32.load (i32.add (i32.const 41984) (i32.shl (local.get $i) (i32.const 2))))))
      (f32.store (i32.add (i32.const 5120) (i32.shl (local.get $i) (i32.const 2))) (local.get $acc))
      (f32.store (i32.add (i32.const 7168) (i32.shl (local.get $i) (i32.const 2))) (local.get $acc))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $frame)))
    (i32.const 0))
  (func (export "reset") (param i32) (result i32) (local $k i32)
    (block $d (loop $l (br_if $d (i32.ge_u (local.get $k) (i32.const 8)))
      (i32.store (i32.add (i32.const 47104) (i32.shl (local.get $k) (i32.const 4))) (i32.const 0))
      (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $l)))
    (i32.const 0))
  (func (export "destroy") (param i32))
)
